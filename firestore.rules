rules_version = '2';

// ============================================================
// FIRESTORE SECURITY RULES
//
// Paste into Firebase Console -> Firestore Database -> Rules, for BOTH the
// staging and the live project, then press Publish. Keep this file in the repo
// as the source of truth: rules that live only in the console cannot be
// reviewed, diffed, or restored.
//
// WHY THESE EXIST
// Everything the app enforces about who may do what is enforced in the browser:
// a button is greyed out, a field is made read-only, a menu entry shows a lock.
// All of that can be undone from the browser's own console by anyone who cares
// to. These rules run on Google's servers and decide what the database will
// accept, whatever the page asks for. They are the only boundary that holds.
//
// The rules they replaced were:
//     match /{document=**} { allow read, write: if request.auth != null; }
// which handed every signed-in client the whole database, including collections
// the app has never heard of.
//
// WHAT THESE DO NOT DO
// They do not reproduce the approval system. A proposal is a field inside a
// target inside an array inside a student document, and rules cannot
// practically say "only the pending list changed" about a nested array. An
// assistant must be able to write student documents in order to propose
// anything, so at this level she can write them. The approval rules remain a
// browser-side arrangement between colleagues; these rules stop the database
// being used as something other than this app.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Named accounts make this possible at all: it could not be written while
    // the whole team shared one login. Kept to the settings below, where the
    // app's own locks already agree, rather than spread thin over data an
    // assistant has to be able to write.
    function isMainTeacher() {
      return signedIn() && request.auth.token.email in [
        'daisy@session-tracker.app',
        'nigel@session-tracker.app',
        'lewis@session-tracker.app'
      ];
    }

    // ── Session records ──────────────────────────────────────
    // The bulk of the client data. Deletes are allowed because the app removes
    // empty and Maintain-only sessions itself.
    match /sessions/{sessionId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAny(['date', 'studentId', 'groupId'])
        && (!('date' in request.resource.data) || request.resource.data.date is string)
        && (!('remarks' in request.resource.data) || request.resource.data.remarks is map)
        && (!('activities' in request.resource.data) || request.resource.data.activities is map);
    }

    // ── Student and group configuration ──────────────────────
    // Split by operation rather than testing request.method: on a delete there
    // is no request.resource to inspect at all.
    match /students/{studentId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && request.resource.data.name is string;
    }

    match /groups/{groupId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && request.resource.data.name is string;
    }

    // ── App-wide settings ────────────────────────────────────
    // Two documents only: the half-year report prompt, and the trial score
    // scale. Naming them stops anything else being written into this space.
    //
    // Both are reached through Score Settings and the AI prompt editor, which
    // are already locked to main teachers in the app, so the rule says out loud
    // what the screens already do. One scale decides every score in the app and
    // one prompt decides what goes into every report.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isMainTeacher() && docId in ['halfYearReport', 'scoring'];
    }

    // ── Supporting collections ───────────────────────────────
    // Left open to anyone signed in. trash in particular: expired items are
    // cleared on startup by whoever opens the app first, so restricting writes
    // here would break an ordinary session for an assistant.
    // ── Edit Target locks ────────────────────────────────────
    // One small document per target, saying who has that target's Edit Target
    // screen open. It is written on opening and deleted on closing, so two
    // people cannot both be editing one target and overwrite each other.
    //
    // Its own collection on purpose. Kept on the student document instead,
    // every lock and unlock would rewrite that whole record -- which is the
    // very thing the lock exists to prevent.
    //
    // Anyone signed in may take or release one: an assistant has to be able to
    // lock a target to edit it, and has to be able to clear a dead lock left
    // by a laptop that went to sleep.
    match /editLocks/{lockId} { allow read, write: if signedIn(); }

    match /remarkPresets/{presetId} { allow read, write: if signedIn(); }
    match /templates/{templateId}   { allow read, write: if signedIn(); }
    match /trash/{trashId}          { allow read, write: if signedIn(); }
    match /aiUsage/{usageId}        { allow read, write: if signedIn(); }

    // ── Everything else ──────────────────────────────────────
    // Denied. The old catch-all let a client create collections the app has
    // never heard of, which is free storage for anyone holding the credentials
    // and gives an attacker somewhere to stage data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
